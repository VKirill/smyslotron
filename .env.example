# Ключи эмбеддинг-провайдеров (без них соответствующие варианты пропускаются)
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=
DASHSCOPE_API_KEY=

# DeepSeek — разметка интентов фраз
DEEPSEEK_API_KEY=

# --- Настройки DeepSeek (все опциональны) ---
# Модель (по умолчанию deepseek-v4-flash — самая дешёвая и быстрая)
#DEEPSEEK_MODEL=deepseek-v4-flash
# Ризонинг (thinking-режим): 0 = выключен (по умолчанию), 1 = включён.
# С ризонингом разметка точнее на спорных интентах, но дороже и медленнее —
# reasoning-токены тарифицируются как выходные ($0.42/1M).
#DEEPSEEK_REASONING=0
# Уровень мышления при включённом ризонинге: high (по умолчанию) | max
#DEEPSEEK_EFFORT=high
# Температура (по умолчанию 0.1 — детерминированная классификация)
#DEEPSEEK_TEMP=0.1

# Пример «включён ризонинг на максимум»:
#DEEPSEEK_REASONING=1
#DEEPSEEK_EFFORT=max

# Опционально: лимит запросов в минуту для Gemini (по умолчанию 15000)
GEMINI_RPM=15000

# Vast.ai — автоаренда RAM-машины для HAC, если локальной памяти не хватает
VASTAI_API_KEY=
# режим: gpu (дефолт) — HAC на CUDA за минуты (NN-chain, pipeline_lib/gpu_hac.py),
# cpu — scipy на RAM-машине (фолбэк). Замер на 104 602 смыслах: H200 — 7 мин/$0.39, CPU 503 ГБ — >70 мин
VASTAI_MODE=gpu
# потолки цены, $/час: GPU (H200 140 ГБ ~$3.3, A100 80 ГБ ~$0.9) и CPU (252 ГБ от $0.10)
VASTAI_GPU_MAX_DPH=4.0
VASTAI_MAX_DPH=1.0
